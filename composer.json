{
    "name": "nanocrm/helpdesk",
    "description": "Client Laravel du support de nanoCRM : ouvrir et suivre des tickets depuis une application, recevoir les webhooks signés.",
    "type": "library",
    "keywords": [
        "nanocrm",
        "helpdesk",
        "support",
        "tickets",
        "laravel",
        "webhooks"
    ],
    "homepage": "https://nanocrm.fr",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nanocrm\\Helpdesk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nanocrm\\Helpdesk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nanocrm\\Helpdesk\\HelpdeskServiceProvider"
            ],
            "aliases": {
                "Helpdesk": "Nanocrm\\Helpdesk\\Facades\\Helpdesk"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
